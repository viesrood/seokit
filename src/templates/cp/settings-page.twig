{% extends "_layouts/cp" %}

{% set title = 'SEO settings'|t('seokit') %}
{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = true %}

{% block content %}
	{# Bewust niet plugins/save-plugin-settings: die bewaart alleen de geposte
	   sleutels en vervangt daarmee de rest van de instellingen. #}
	<input type="hidden" name="action" value="seokit/settings/save">
	{{ redirectInput('seokit/settings') }}

	{# The partial is written for the plugin settings screen, where Craft
	   namespaces everything itself. On our own page we do it here. #}
	{% namespace 'settings' %}
		{% include "seokit/cp/settings" %}
	{% endnamespace %}
{% endblock %}
