{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = 'Robots and sitemap'|t('seokit') %}
{% set selectedSubnavItem = 'robots' %}
{% set fullPageForm = true %}

{% block content %}
	{# Bewust niet plugins/save-plugin-settings: die bewaart alleen de geposte
	   sleutels en vervangt daarmee de rest van de instellingen. #}
	<input type="hidden" name="action" value="seokit/settings/save">
	{{ redirectInput('seokit/robots') }}

	{% namespace 'settings' %}

		<h2>{{ 'Sitemap'|t('seokit') }}</h2>

		{{ forms.lightswitchField({
			label: 'Serve a sitemap'|t('seokit'),
			id: 'sitemapEnabled',
			name: 'sitemapEnabled',
			on: settings.sitemapEnabled,
		}) }}

		{% if settings.sitemapEnabled %}
			<p class="light">{{ 'Index:'|t('seokit') }} <a href="{{ sitemapUrl }}" target="_blank" rel="noopener">{{ sitemapUrl }}</a></p>

			{% if sections|length %}
				<ul class="bullets">
					{% for section in sections %}
						<li>
							<a href="{{ siteUrl('sitemap-' ~ section.handle ~ '.xml') }}" target="_blank" rel="noopener">
								sitemap-{{ section.handle }}.xml
							</a>
							<span class="light">{{ section.name }}</span>
						</li>
					{% endfor %}
				</ul>
			{% else %}
				<p class="light">{{ 'No sections with public URLs, so the sitemap would be empty.'|t('seokit') }}</p>
			{% endif %}

			<p class="light">
				{{ 'No priority or change frequency: Google has ignored both for years, and a number that is ignored is a number nobody should have to maintain.'|t('seokit') }}
			</p>
		{% endif %}

		<hr>

		<h2>{{ 'robots.txt'|t('seokit') }}</h2>

		{% if physicalFile %}
			<div class="readable">
				<blockquote class="note warning">
					<p>
						{{ 'There is a robots.txt file on disk at {path}. A file always wins over a route, so anything typed below is ignored until that file is removed.'|t('seokit', { path: physicalFile }) }}
					</p>
				</blockquote>
			</div>
		{% endif %}

		{{ forms.lightswitchField({
			label: 'Serve robots.txt from here'|t('seokit'),
			id: 'robotsTxtEnabled',
			name: 'robotsTxtEnabled',
			on: settings.robotsTxtEnabled,
		}) }}

		{{ forms.textareaField({
			label: 'Contents'|t('seokit'),
			instructions: '{sitemap} expands to the sitemap index URL, {llms} to the llms.txt URL, and {aiCrawlers} to the block from the AI settings below. Leave that last one out and the block is appended at the end.'|t('seokit'),
			id: 'robotsTxt',
			name: 'robotsTxt',
			value: settings.robotsTxt,
			rows: 10,
			class: 'code',
		}) }}

		<div class="readable">
			<blockquote class="note">
				<p>
					<strong>{{ 'Disallow does not mean "keep out of Google".'|t('seokit') }}</strong>
					{{ 'A disallowed URL is never fetched, so the noindex tag on that page is never read, and the bare URL can still be listed the moment something links to it. To keep a page out of results, let it be crawled and turn off "Show in search engines" on the page itself.'|t('seokit') }}
				</p>
			</blockquote>
		</div>

		{% if disallowRules|length %}
			<p class="light">
				{{ 'Disallowed for every crawler:'|t('seokit') }}
				{% for rule in disallowRules %}<code>{{ rule }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
			</p>
		{% endif %}

		<hr>

		<h2>{{ 'AI crawlers'|t('seokit') }}</h2>

		<div class="readable">
			<p class="light">
				{{ 'Two separate decisions. Refusing to be training data costs nothing in search results. Refusing the answer engines takes this site out of ChatGPT, Claude and Perplexity answers, including the links back to it.'|t('seokit') }}
			</p>
		</div>

		{{ forms.lightswitchField({
			label: 'Block AI training crawlers'|t('seokit'),
			instructions: 'GPTBot, ClaudeBot, Amazonbot, Bytespider, CCBot and the Google-Extended and Applebot-Extended opt-out tokens. Those last two are not crawlers: blocking them keeps Gemini and Apple Intelligence from training on this site without affecting Googlebot or Applebot.'|t('seokit'),
			id: 'blockAiTraining',
			name: 'blockAiTraining',
			on: settings.blockAiTraining,
		}) }}

		{{ forms.lightswitchField({
			label: 'Block AI answer engines'|t('seokit'),
			instructions: 'OAI-SearchBot, ChatGPT-User, Claude-SearchBot, Claude-User and PerplexityBot. These fetch a page to answer a question and link back to it, so blocking them removes this site from those answers.'|t('seokit'),
			id: 'blockAiSearch',
			name: 'blockAiSearch',
			on: settings.blockAiSearch,
		}) }}

		{{ forms.textField({
			label: 'Content-Signal'|t('seokit'),
			instructions: 'A statement of intent for crawlers that read it, on one line. It is not enforcement: the switches above are. Empty means say nothing.'|t('seokit'),
			id: 'contentSignal',
			name: 'contentSignal',
			value: settings.contentSignal,
			class: 'code',
		}) }}

		{% if contradictions|length %}
			<div class="readable">
				<blockquote class="note warning">
					<p>
						{{ 'Content-Signal says {directives} while those crawlers are being blocked above. Only the rules are enforced, so the file would claim one thing and do another.'|t('seokit', { directives: contradictions|join(', ') }) }}
					</p>
				</blockquote>
			</div>
		{% endif %}

		<div class="readable">
			<p class="light">
				{{ 'Not every crawler obeys robots.txt; Bytespider has a history of ignoring it. This is the strongest signal available, not a guarantee.'|t('seokit') }}
			</p>
		</div>

		{% if aiBlock|trim %}
			<h3>{{ 'Added to robots.txt'|t('seokit') }}</h3>
			<pre class="code" style="white-space: pre-wrap;">{{ aiBlock }}</pre>
		{% endif %}

	{% endnamespace %}
{% endblock %}
