{
    "name": "viesrood/seokit",
    "description": "SEO for Craft CMS 5 that works before you configure it: derived meta with a visible origin trail, one compact field per entry, a JSON-LD entity graph, sitemaps and robots.txt. Renders in your template instead of injecting into the response.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "seo",
        "meta",
        "sitemap",
        "schema",
        "json-ld",
        "opengraph"
    ],
    "support": {
        "docs": "https://github.com/viesrood/seokit/blob/main/README.md",
        "issues": "https://github.com/viesrood/seokit/issues",
        "source": "https://github.com/viesrood/seokit"
    },
    "require": {
        "craftcms/cms": "^5.0.0",
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "viesrood\\seokit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "viesrood\\seokit\\tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M"
    },
    "extra": {
        "handle": "seokit",
        "name": "SeoKit",
        "class": "viesrood\\seokit\\Plugin",
        "developer": "Viesrood",
        "developerUrl": "https://viesrood.nl",
        "documentationUrl": "https://github.com/viesrood/seokit",
        "changelogUrl": "https://raw.githubusercontent.com/viesrood/seokit/main/CHANGELOG.md"
    }
}
